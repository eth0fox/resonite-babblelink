<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Deterministic>true</Deterministic>
        <Version>1.1.0</Version>
        <AssemblyTitle>BabbleFrameRuntime Resonite Mod</AssemblyTitle>
        <Product>Resonite mod for that adds first-class support for the Babble Frame Runtime BabbleLink protocol without the need for VRCFT.</Product>
        <Company>eth0fox</Company>
        <Copyright>(c) 2026 eth0fox. Licensed under a permissive license. See https://git.boxfox.es/fox/resonite-babblelink/src/branch/main/LICENSE</Copyright>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ResoniteModLoader" Version="5.0.1" ExcludeAssets="runtime" />
        <PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup Condition="!Exists('$(ResonitePath)FrooxEngine.dll')">
        <PackageReference Include="Resonite.GameLibs" Version="2026.9.18.82"  ExcludeAssets="runtime" />
        <PackageReference Include="Rug.Osc" Version="1.2.5"  ExcludeAssets="runtime" />
    </ItemGroup>
    <ItemGroup Condition="Exists('$(ResonitePath)FrooxEngine.dll')">
        <Reference Include="FrooxEngine">
            <HintPath>$(ResonitePath)FrooxEngine.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Elements.Core">
            <HintPath>$(ResonitePath)Elements.Core.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Renderite.Shared">
            <HintPath>$(ResonitePath)Renderite.Shared.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Rug.Osc">
            <HintPath>$(ResonitePath)Rug.Osc.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(CopyToMods)'=='true' And Exists('$(ResonitePath)rml_mods')">
        <Message Text="Attempting to copy $(TargetFileName) to $(ResonitePath)rml_mods" Importance="high" />
        <Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFolder="$(ResonitePath)rml_mods" ContinueOnError="true" />
    </Target>


</Project>
